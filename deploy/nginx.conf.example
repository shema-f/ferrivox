# Example nginx config for self-hosting the Ferrivox static build (dist/).
#
# Why precompressed sidecars: the Vite build writes .br and .gz next to
# every compressible asset (see precompressAssets in vite.config.ts), so
# nginx serves them with zero runtime CPU — just `brotli_static on;` and
# `gzip_static on;`.

server {
    listen 443 ssl http2;
    server_name ferrivox.com;

    root /var/www/ferrivox/dist;
    index index.html;

    # ── TLS (certbot manages these) ─────────────────────────────────────
    # ssl_certificate     /etc/letsencrypt/live/ferrivox.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/ferrivox.com/privkey.pem;

    # ── Precompressed responses ─────────────────────────────────────────
    # Serve .br/.gz sidecars when the client sends Accept-Encoding.
    # Requires the ngx_brotli module for brotli_static (commonly bundled
    # in nginx.org packages as ngx_brotli_filter/static). nginx adds the
    # Content-Encoding header itself — never set it manually.
    brotli_static on;
    gzip_static  on;

    # Fallback: on-the-fly compression for anything without a sidecar
    gzip on;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript
               application/xml image/svg+xml;

    # ── Hashed assets: immutable, cache forever ─────────────────────────
    location /assets/ {
        # "immutable" skips conditional revalidation entirely in modern
        # browsers — the strongest caching signal available.
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # ── HTML: revalidate every load so deploys propagate immediately ────
    location = /index.html {
        add_header Cache-Control "public, max-age=0, must-revalidate";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # ── SPA fallback + everything else ──────────────────────────────────
    # (Admin page uses #/admin hash routing, but keep a clean /admin path.)
    location / {
        try_files $uri $uri/ /index.html;

        add_header Cache-Control "public, max-age=3600";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    }

    # ── Long cache for fonts if you add self-hosted ones later ─────────
    # location ~* \.(woff2|woff)$ {
    #     add_header Cache-Control "public, max-age=31536000, immutable";
    #     add_header Access-Control-Allow-Origin "*";
    # }
}

# HTTP → HTTPS redirect
server {
    listen 80;
    server_name ferrivox.com;
    return 301 https://$host$request_uri;
}
